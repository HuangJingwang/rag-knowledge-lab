  {
    "id": "demo:chunk:01",
    "title": "项目立项：减少支付漏单",
    "text": "商城支付升级项目希望降低支付漏单率。验收目标是将支付成功但订单状态未更新的比例控制在 0.05% 以下。项目经理王蕾负责协调；核心工作包括支付结果查询接口、支付回调改造和支付联调验收。本文及本演示所有人物、任务和数字均为虚构。",
    "source_type": "document",
    "source_id": "demo:doc:charter",
    "project": "商城支付升级项目",
    "created_at": "2026-09-01T09:00:00+08:00",
    "valid_from": "2026-09-01T09:00:00+08:00",
